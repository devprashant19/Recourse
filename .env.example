# Recourse — environment variables
#
# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# `npm run judge` runs gitleaks over the repo and its history; a leaked key fails the build.
#
# Sandbox mode (`pnpm demo`) needs NONE of these. That is the point: a judge clones and runs.

# ----- Mode and contract -------------------------------------------------------------------
# sandbox (default) | testnet | mainnet
RECOURSE_MODE=sandbox
# Set by scripts/deploy.ts for testnet and mainnet
RECOURSE_CONTRACT_ID=

# ----- Deploy only -------------------------------------------------------------------------
# NEVER place these on the hosted server. Deploy runs from a laptop.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# ----- Service accounts --------------------------------------------------------------------
# Each service gets a FUNCTION-CALL key limited to the methods listed, never a full-access key.

# Function-call key limited to: accept_engagement, submit_receipt (scripts/lib/service-keys.ts).
# Payable calls (register_agent, post_bond) need the account's full-access key and are not done by the service.
AGENT_ACCOUNT_ID=
AGENT_FC_KEY=
# Used once by `pnpm setup-service-keys` to add the function-call key; never given to the service.
AGENT_FULL_ACCESS_KEY=

# Function-call key limited to: resolve_claim
ARBITER_ACCOUNT_ID=
ARBITER_FC_KEY=
ARBITER_FULL_ACCESS_KEY=

# Function-call key limited to: execute_payout, register_signer (confirm_payout arrives in Phase 3)
KEEPER_ACCOUNT_ID=
KEEPER_FC_KEY=
KEEPER_FULL_ACCESS_KEY=

# limited to: open_bond_request, commit_bid, reveal_bid, settle_round
UNDERWRITER_1_ACCOUNT_ID=
UNDERWRITER_1_FC_KEY=
UNDERWRITER_2_ACCOUNT_ID=
UNDERWRITER_2_FC_KEY=
UNDERWRITER_3_ACCOUNT_ID=
UNDERWRITER_3_FC_KEY=

# demo only — the testnet client the hosted demo acts as
CLIENT_ACCOUNT_ID=
CLIENT_KEY=

# Sputnik DAO v2 account that hears appeals (contract init + UI)
COUNCIL_DAO_ID=

# ----- NEAR AI Cloud -----------------------------------------------------------------------
# Testnet and mainnet only. Sandbox replays recorded fixtures from demo/fixtures.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai
# Private TEE model IDs from GET /v1/models
NEARAI_MODEL_WORKER=
NEARAI_MODEL_ARBITER=

# ----- NEAR Intents / 1Click ---------------------------------------------------------------
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional, but avoids the 0.25% unauthenticated fee
ONECLICK_JWT=

# ----- Assets ------------------------------------------------------------------------------
# Mainnet contract init. Confirm from GET /v0/tokens and the NEAR explorer. Never hard-code
# asset IDs in code — the keeper reads them from /v0/tokens at startup.
USDC_TOKEN_ID=

# ----- Indexer and web ---------------------------------------------------------------------
INDEXER_DB_PATH=./.data/recourse.sqlite
ARTIFACT_DIR=./.data/artifacts
API_URL=http://localhost:8080

# ----- Phase 2 services ---------------------------------------------------------------------
# Optional RPC override (defaults: sandbox http://127.0.0.1:3030, testnet https://test.rpc.fastnear.com)
RECOURSE_RPC_URL=
WORKER_POLL_MS=2000
ARBITER_POLL_MS=2000
WORKER_STATE_FILE=
ARBITER_STATE_FILE=
DOCUMENTS_DIR=demo/documents
# Worker admin server (sabotage switch) — sandbox/testnet only, never mainnet. Loopback only.
# At least 32 random characters, e.g. `openssl rand -hex 32`. Leave empty to disable the server.
WORKER_ADMIN_TOKEN=
WORKER_ADMIN_PORT=8787
